{{!
    @template local_courseplan/plan_list

    Screen 1: Course Syllabus Plans List (Bảng chuẩn Moodle html_table).
}}
<div class="local-courseplan-list-container">
    {{#isediting}}
        {{#canmanage}}
            <div class="d-flex justify-content-end mb-3">
                <a href="{{newplanurl}}" class="btn btn-primary">
                    {{#pix}} t/add, core {{/pix}} {{#str}} add_plan, local_courseplan {{/str}}
                </a>
            </div>
        {{/canmanage}}
    {{/isediting}}

    {{#hasplans}}
        {{{tablehtml}}}
    {{/hasplans}}
    {{^hasplans}}
        <div class="alert alert-info py-4 my-3 text-center">
            <p class="mb-0 fs-6">{{emptymessage}}</p>
        </div>
    {{/hasplans}}
</div>
